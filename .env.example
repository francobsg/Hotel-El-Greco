# La URL incluye usuario y contraseña; cámbialos en .env.local, nunca en el código.
# PostgreSQL/Supabase para el runtime; en Vercel usar pooler de transaccion (prepare:false).
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/hotel_el_greco
# Opcional: maximo de conexiones PostgreSQL por proceso (1 a 20).
# Opcional: conexión directa/pooler de sesión, preferida para las migraciones.
MIGRATIONS_DATABASE_URL=
DATABASE_POOL_MAX=10
# Secreto aleatorio de al menos 32 caracteres para firmar sesiones.
AUTH_SECRET=
# OCR opcional. Sin clave se usa MockOcr con aviso de demostracion.
OPENAI_API_KEY=
# Modelo de vision con Structured Outputs (solo servidor).
OPENAI_OCR_MODEL=gpt-4.1-mini
# Supabase Storage: bucket privado existente; credenciales solo del servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=facturas
# Opcional para ejecucion local/E2E: directorio de imagenes del escaner.
# En desarrollo sin Storage se usa public/uploads; en produccion configurar Storage o volumen.
ESCANER_UPLOADS_DIR=
# Obligatoria para el seed. Usar una clave temporal de al menos 12 caracteres.
SEED_PASSWORD=

# Opcional: directorio privado y persistente para fotos de facturas (por defecto .data/facturas).
FACTURAS_DIR=
